# hangarr settings: copy to .env (never commit it). Read by compose.yml (production) and by `make dev-real`.
# Everything is optional. Sonarr, Radarr, Plex or Jellyfin, and Tautulli are best configured in the UI (Settings › Services);
# a service variable set here wins and is locked in the UI.
# Full reference: docs/configuration.md

# --- Safety -------------------------------------------------------------------------------------------------
# Keep true until you really want deletions to happen.
DRY_RUN=true
# Items tagged like this in Sonarr/Radarr are never proposed nor deleted (comma-separated).
PROTECTED_TAGS=keep

# --- Web access ---------------------------------------------------------------------------------------------
# Session cookies are sent over HTTPS only. To test over plain HTTP on your LAN (http://<ip>:8080), set false;
# put it back to true behind an HTTPS reverse proxy.
COOKIE_SECURE=true
# Reverse proxies allowed to send X-Forwarded-For (CIDR or addresses, comma-separated), e.g. 172.18.0.0/16.
TRUSTED_PROXIES=
# Over plain HTTP, only local names are served (IPs, localhost, names without a dot, .lan, .local...). Add the other
# names you use over HTTP, comma-separated, e.g. nas.example.com (DNS rebinding protection; HTTPS is not checked).
ALLOWED_HOSTS=
TZ=Europe/Paris
# Interface language when the user has not chosen one: en (default) or fr.
DEFAULT_LANG=en
# Password of the admin account created at the first start. Policy: 12+ characters, lower and upper case, a digit, a
# symbol, not containing the username, not a common password.
# Empty: a password is generated, printed once in the logs and must be changed at the first sign-in.
# Only used to create the account, then ignored with a warning: remove it afterwards. While set, it is checked at
# every start: a weak value stops the application.
HANGARR_ADMIN_PASSWORD=

# --- compose.yml only ---------------------------------------------------------------------------------------
# Image to run (default: ghcr.io/migipasso/hangarr:v1.3.1, the published image) and published port.
# HANGARR_IMAGE=ghcr.io/migipasso/hangarr:v1.3.1
# HANGARR_PORT=8080

# --- Services (optional: prefer Settings › Services) -----------------------------------------------------
SONARR_URL=
SONARR_API_KEY=
RADARR_URL=
RADARR_API_KEY=
PLEX_URL=
PLEX_TOKEN=
TAUTULLI_URL=
TAUTULLI_API_KEY=
# Jellyfin instead of Plex: set PLEX_URL/PLEX_TOKEN or JELLYFIN_URL/JELLYFIN_API_KEY, not both.
JELLYFIN_URL=
JELLYFIN_API_KEY=
JELLYFIN_PUBLIC_URL=
