# hangarr settings: copy to .env (never commit it). Read by compose.yml (production) and by `make dev-real`.
# Everything is optional. Sonarr, Radarr, Plex and Tautulli are best configured in the UI (Configuration page);
# a service variable set here wins and is locked in the UI.

# --- Safety -------------------------------------------------------------------------------------------------
# Keep true until you really want deletions to happen.
DRY_RUN=true
# Items tagged like this in Sonarr/Radarr are never proposed nor deleted (comma-separated).
PROTECTED_TAGS=keep

# --- Web access ---------------------------------------------------------------------------------------------
# Session cookies are sent over HTTPS only. To test over plain HTTP on your LAN (http://<ip>:8080), set false;
# put it back to true behind an HTTPS reverse proxy.
COOKIE_SECURE=true
# Reverse proxies allowed to send X-Forwarded-For (CIDR or addresses, comma-separated), e.g. 172.18.0.0/16.
TRUSTED_PROXIES=
TZ=Europe/Paris
# Interface language when the user has not chosen one: en (default) or fr.
DEFAULT_LANG=en
# Password of the admin account created at the first start (12+ characters, lower and upper case, digit, symbol).
# Empty: a password is generated, printed once in the logs and must be changed at the first sign-in.
# Only read when the account does not exist yet: remove it afterwards.
HANGARR_ADMIN_PASSWORD=

# --- compose.yml only ---------------------------------------------------------------------------------------
# Image to run (default: built locally from the sources) and published port.
# HANGARR_IMAGE=ghcr.io/<user>/hangarr:latest
# HANGARR_PORT=8080

# --- Services (optional: prefer the Configuration page) -----------------------------------------------------
SONARR_URL=
SONARR_API_KEY=
RADARR_URL=
RADARR_API_KEY=
PLEX_URL=
PLEX_TOKEN=
TAUTULLI_URL=
TAUTULLI_API_KEY=
